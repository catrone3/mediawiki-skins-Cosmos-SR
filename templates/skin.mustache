<div class="sc-wrapper">
	<header class="sc-header">
		<div class="sc-header-logo-container">
			{{#data-logos}}
				<img src="{{1x}}" alt="{{site-name}}" class="sc-header-logo">
			{{/data-logos}}
			<div class="sc-header-titles">
				<h1 class="sc-site-title">{{site-name}}</h1>
				<p class="sc-site-tagline">{{site-tagline}}</p>
			</div>
		</div>
		
		<div class="sc-user-tools">
			<div class="sc-search">
				<form action="{{data-search-action}}" class="sc-search-form">
					<input type="search" name="search" placeholder="{{msg-search}}" class="sc-search-input">
					<button type="submit" class="sc-search-button">{{msg-search}}</button>
				</form>
			</div>
			
			<div class="sc-user-links">
				{{#data-personal-menu.items}}
					<a href="{{link-href}}" class="sc-user-link" {{#link-class}}class="{{.}}"{{/link-class}}>
						{{link-text}}
					</a>
				{{/data-personal-menu.items}}
			</div>
		</div>
		
		<button class="sc-mobile-menu-toggle">
			<span></span>
			<span></span>
			<span></span>
		</button>
	</header>
	
	<nav class="sc-nav">
		<ul class="sc-nav-list">
			{{#data-portlets.data-namespaces.array-items}}
				<li class="sc-nav-item">
					<a href="{{link-href}}" class="sc-nav-link" {{#link-class}}class="{{.}}"{{/link-class}}>
						{{link-text}}
					</a>
				</li>
			{{/data-portlets.data-namespaces.array-items}}
			
			{{#data-portlets.data-views.array-items}}
				<li class="sc-nav-item">
					<a href="{{link-href}}" class="sc-nav-link" {{#link-class}}class="{{.}}"{{/link-class}}>
						{{link-text}}
					</a>
				</li>
			{{/data-portlets.data-views.array-items}}
		</ul>
	</nav>
	
	<div class="sc-content-container">
		<aside class="sc-sidebar">
			<div class="sc-portlet">
				<h3>{{msg-navigation}}</h3>
				<ul>
					{{#data-portlets.data-navigation.array-items}}
						<li>
							<a href="{{link-href}}">{{link-text}}</a>
						</li>
					{{/data-portlets.data-navigation.array-items}}
				</ul>
			</div>
			
			<div class="sc-portlet">
				<h3>{{msg-toolbox}}</h3>
				<ul>
					{{#data-portlets.data-actions.array-items}}
						<li>
							<a href="{{link-href}}">{{link-text}}</a>
						</li>
					{{/data-portlets.data-actions.array-items}}
				</ul>
			</div>
		</aside>
		
		<main class="sc-content">
			<div class="sc-content-header">
				<h1 class="firstHeading" id="firstHeading">
					{{{html-title}}}
				</h1>
				
				<div class="sc-content-actions">
					{{#data-portlets.data-actions.array-items}}
						<a href="{{link-href}}" class="sc-action-button" {{#link-class}}class="{{.}}"{{/link-class}}>
							{{link-text}}
						</a>
					{{/data-portlets.data-actions.array-items}}
				</div>
			</div>
			
			<div class="sc-body-content">
				{{{html-body-content}}}
			</div>
			
			{{#data-categories}}
				<div class="sc-categories">
					{{{html-categories}}}
				</div>
			{{/data-categories}}
		</main>
	</div>
	
	<footer class="sc-footer">
		<div class="sc-footer-content">
			<div class="sc-footer-links">
				{{#data-footer.data-places.array-items}}
					<a href="{{link-href}}" class="sc-footer-link">
						{{link-text}}
					</a>
				{{/data-footer.data-places.array-items}}
			</div>
			
			<div class="sc-footer-info">
				{{#data-footer.data-info.array-items}}
					<div class="sc-footer-info-item">
						{{{html}}}
					</div>
				{{/data-footer.data-info.array-items}}
			</div>
		</div>
		
		<div class="sc-kofi-support">
			{{{html-kofi-button}}}
		</div>
	</footer>
</div>
