{
    "name": "ShadowCosmos",
    "version": "1.0.0",
    "author": "[Your Name]",
    "url": "https://www.mediawiki.org/wiki/Skin:ShadowCosmos",
    "descriptionmsg": "shadowcosmos-desc",
    "namemsg": "skinname-shadowcosmos",
    "license-name": "GPL-2.0-or-later",
    "type": "skin",
    "requires": {
        "MediaWiki": ">= 1.35.0"
    },
    "ValidSkinNames": {
        "shadowcosmos": {
            "class": "SkinCosmos",
            "args": [
                {
                    "name": "shadowcosmos",
                    "styles": [
                        "skins.shadowcosmos"
                    ],
                    "scripts": [
                        "skins.shadowcosmos.js"
                    ],
                    "template": "CosmosTemplate"
                }
            ]
        }
    },
    "MessagesDirs": {
        "ShadowCosmos": [
            "i18n"
        ]
    },
    "ResourceModules": {
        "skins.shadowcosmos": {
            "class": "ResourceLoaderSkinModule",
            "features": [
                "normalize",
                "elements",
                "content",
                "interface",
                "logo",
                "legacy"
            ],
            "styles": {
                "resources/libraries/normalise.css": {
                    "media": "screen"
                },
                "resources/screen-common.less": {
                    "media": "screen"
                },
                "resources/screen-desktop.less": {
                    "media": "screen and (min-width: 851px)"
                },
                "resources/screen-mobile.less": {
                    "media": "screen and (max-width: 850px)"
                }
            }
        },
        "skins.shadowcosmos.js": {
            "scripts": [
                "resources/main.js"
            ],
            "dependencies": [
                "mediawiki.util"
            ]
        }
    },
    "ResourceFileModulePaths": {
        "localBasePath": "",
        "remoteSkinPath": "ShadowCosmos"
    },
    "AutoloadClasses": {
        "SkinShadowCosmos": "includes/SkinShadowCosmos.php",
        "ShadowCosmosTemplate": "includes/ShadowCosmosTemplate.php"
    },
    "manifest_version": 2
}